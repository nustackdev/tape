{
	"name": "@nustackdev/tape-scene",
	"description": "The tape scene format: what a recorded websocket UI session looks like on disk.",
	"version": "0.3.0",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nustackdev/tape.git",
		"directory": "packages/scene"
	},
	"homepage": "https://github.com/nustackdev/tape#readme",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"prepack": "cp ../../LICENSE.md ."
	},
	"publishConfig": {
		"access": "public"
	}
}
