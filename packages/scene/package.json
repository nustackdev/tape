{
	"name": "@nustackdev/tape-scene",
	"description": "The tape scene format: what a recorded websocket UI session looks like on disk.",
	"version": "0.1.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	}
}
