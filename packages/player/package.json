{
	"name": "@nustackdev/tape-player",
	"description": "Replay a tape scene: the real app in an iframe, its websocket fed from the recording, a cursor on top.",
	"version": "0.1.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./shim.js": "./dist/shim.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@nustackdev/tape-scene": "workspace:*"
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"devDependencies": {
		"@types/react": "^19.2.7",
		"react": "^19.2.0"
	}
}
