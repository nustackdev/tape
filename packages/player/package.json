{
	"name": "@nustackdev/tape-player",
	"description": "Replay a tape scene: the real app in an iframe, its websocket fed from the recording, on a clock the page controls, with scrub, chapters and captions.",
	"version": "0.3.2",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nustackdev/tape.git",
		"directory": "packages/player"
	},
	"homepage": "https://github.com/nustackdev/tape#readme",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./shim.js": "./dist/shim.js",
		"./tape.css": "./dist/tape.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"prepack": "cp ../../LICENSE.md ."
	},
	"dependencies": {
		"@nustackdev/tape-scene": "workspace:*"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
	},
	"devDependencies": {
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"esbuild": "^0.28.2",
		"happy-dom": "^21.0.1",
		"playwright": "~1.63.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": [
		"*.css"
	]
}
